# VCS
.git
.gitignore

# Dependencies (installed in image)
vendor
node_modules

# Environment / secrets (provided at runtime)
.env
.env.*
!.env.example

# Tests & docs not needed in image
tests
docs

# Laravel runtime artifacts
storage/logs
storage/framework/cache
storage/framework/sessions
storage/framework/views
bootstrap/cache/*.php

# Local SQLite DB (rebuilt during image build)
database/*.sqlite
database/*.sqlite-journal

# OS/editor
.DS_Store
Thumbs.db
.idea
.vscode
